  "components": {
    "schemas": {
      "ArchiveMaintenanceRequest": {
        "properties": {
          "compact": {
            "type": "boolean",
            "title": "Compact",
            "default": false
          },
          "confirmation_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 16,
            "title": "Confirmation Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmation_token"
        ],
        "title": "ArchiveMaintenanceRequest"
      },
      "ArchivePreviewRequest": {
        "properties": {
          "compact": {
            "type": "boolean",
            "title": "Compact",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ArchivePreviewRequest"
      },
      "ControlRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ControlRequest"
      },
      "DirectBookDownloadRequest": {
        "properties": {
          "skip_existing": {
            "type": "boolean",
            "title": "Skip Existing",
            "default": true
          },
          "include_book_id": {
            "type": "boolean",
            "title": "Include Book Id",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DirectBookDownloadRequest"
      },
      "DownloadByNameRequest": {
        "properties": {
          "book_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Book Name"
          },
          "author_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Author Name"
          },
          "exact_match": {
            "type": "boolean",
            "title": "Exact Match",
            "default": true
          },
          "max_search_pages": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Search Pages",
            "default": 5
          },
          "skip_existing": {
            "type": "boolean",
            "title": "Skip Existing",
            "default": true
          },
          "include_book_id": {
            "type": "boolean",
            "title": "Include Book Id",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "book_name"
        ],
        "title": "DownloadByNameRequest"
      },
      "EgressModeRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "automatic",
              "nas-primary",
              "dps-fallback"
            ],
            "title": "Mode"
          },
          "reset_breaker": {
            "type": "boolean",
            "title": "Reset Breaker",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "EgressModeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdentityRotateRequest": {
        "properties": {
          "confirmation_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 16,
            "title": "Confirmation Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmation_token"
        ],
        "title": "IdentityRotateRequest"
      },
      "ProtocolProbeRequest": {
        "properties": {
          "slot_id": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "nas-primary",
                  "dps-fallback",
                  "default"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Slot Id"
          },
          "force_new_proxy": {
            "type": "boolean",
            "title": "Force New Proxy",
            "default": false
          },
          "keyword": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Keyword",
            "default": "魔法"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProtocolProbeRequest"
      },
      "RankingSpec": {
        "properties": {
          "order": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Order"
          },
          "time_type": {
            "type": "string",
            "enum": [
              "week",
              "month",
              "total"
            ],
            "title": "Time Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order",
          "time_type"
        ],
        "title": "RankingSpec"
      },
      "SyncAllRequest": {
        "properties": {
          "rankings": {
            "$ref": "#/components/schemas/SyncRankingsRequest"
          },
          "new_books": {
            "$ref": "#/components/schemas/SyncNewBooksRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SyncAllRequest",
        "description": "一次调度中顺序同步榜单和新书，共享同一个代理租约。"
      },
      "SyncNewBooksRequest": {
        "properties": {
          "max_pages": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 1
          },
          "count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Count",
            "default": 100
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SyncNewBooksRequest"
      },
      "SyncRankingsRequest": {
        "properties": {
          "specs": {
            "items": {
              "$ref": "#/components/schemas/RankingSpec"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Specs"
          },
          "count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Count",
            "default": 10
          },
          "category_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Category Index",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SyncRankingsRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
